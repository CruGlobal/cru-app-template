# Local development settings, loaded only by the local run command (see
# README.md). .dockerignore keeps this file out of the image, so it never
# reaches a deploy.

# Who you are when you run the app locally: REPLACE THIS with your own email.
# Every local request is signed in as this person. cru-iap ignores it whenever
# IAP_AUDIENCE is set or the app runs on Cloud Run.
CRU_IAP_DEV_BYPASS_EMAIL=replace-me@cru.org
