source "https://rubygems.org"

gem "rack", "~> 3.1"
gem "puma", "~> 6.4"

# Verifies Google IAP's sign-in assertion (lib/app.rb). Installed from git, so
# bump the tag to upgrade.
gem "cru_iap", github: "CruGlobal/cru-iap", tag: "v0.2.1"

# Database helper (lib/db.rb). Nothing loads these until the app requires it.
gem "pg", "~> 1.6", ">= 1.6.1"
gem "googleauth", "~> 1.11"

group :test do
  gem "minitest", "~> 5.25"
  gem "rake", "~> 13.2"
end

