#!/usr/bin/env bash
# Activate one stack for this Cru app.
#
#   bin/use-stack <ecs|cloudrun|lambda> <nodejs|ruby|python>
#
# Two axes, because a Cru app is two independent choices:
#
#   type      where it runs — ECS, Cloud Run, or Lambda. Under pipeline v2 this
#             only selects the BUILD recipe; deploy/promote/rollback resolve the
#             type server-side from the app's CruApplicationInfo record.
#   language  what it's written in.
#
# This copies the matching stack from stacks/ to the repo root, writes the
# type into .github/workflows/pipeline-v2.yml, writes a matching
# .github/dependabot.yml and .github/workflows/ci.yml, fills in the docs, then
# removes stacks/ and itself so the repo holds exactly one app. Run this ONCE
# near the start of a new app, then commit. See AGENTS.md.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

usage() {
  cat >&2 <<'EOF'
Usage: bin/use-stack <type> <language>

  type      ecs | cloudrun | lambda
  language  nodejs | ruby | python

Examples:
  bin/use-stack ecs nodejs
  bin/use-stack lambda python
  bin/use-stack cloudrun ruby
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

if [ "$#" -ne 2 ]; then
  echo "Error: expected exactly 2 arguments, got $#." >&2
  usage
  exit 1
fi

type="$1"
lang="$2"

# --- Validate the combo, and derive everything that depends on it -------------

# ecs and cloudrun both run "a server that listens on $PORT and answers a health
# check", and that scaffold is identical for them — the platform difference is
# entirely on the infrastructure side. So they share stacks/server/. Lambda is a
# genuinely different shape (a handler, no port) and has its own stacks/lambda/.
# See stacks/README.md.
case "$type" in
  ecs)
    family="server"; type_label="AWS ECS"; tf_module="aws/ecs/app" ;;
  cloudrun)
    family="server"; type_label="Google Cloud Run"; tf_module="gcp/cloudrun/app" ;;
  lambda)
    family="lambda"; type_label="AWS Lambda"; tf_module="aws/lambda/app" ;;
  *)
    echo "Error: unknown type '$type' (expected ecs, cloudrun, or lambda)." >&2
    usage
    exit 1
    ;;
esac

case "$lang" in
  nodejs) eco="npm" ;;
  ruby)   eco="bundler" ;;
  python) eco="pip" ;;
  *)
    echo "Error: unknown language '$lang' (expected nodejs, ruby, or python)." >&2
    usage
    exit 1
    ;;
esac

stack="stacks/$family/$lang"

if [ ! -d stacks ]; then
  echo "Error: stacks/ is gone — this repo looks already activated." >&2
  echo "       bin/use-stack removes both itself and stacks/ after one run." >&2
  exit 1
fi

if [ ! -d "$stack" ]; then
  echo "Error: no stack at $stack (this shouldn't happen — is the repo complete?)." >&2
  exit 1
fi

if [ -e Dockerfile ]; then
  echo "Error: there is already a Dockerfile at the repo root." >&2
  echo "       Refusing to overwrite your app. Remove it first if you meant to" >&2
  echo "       start over from a stack." >&2
  exit 1
fi

echo "→ Activating the $type / $lang stack ($type_label, from $stack)…"

# --- 1. Copy the stack to the root -------------------------------------------

# Copy everything in the stack — including dotfiles like .tool-versions.
cp -R "$stack/." .

# --- 2. Substitute placeholders ----------------------------------------------

# Portable in-place sed (BSD sed's -i needs an argument; GNU's doesn't). Note
# that rewrite-and-mv resets the file mode to the umask default, so anything
# that must stay executable is chmod'd AFTER this runs, not before.
substitute() {
  local f
  for f in "$@"; do
    [ -f "$f" ] || continue
    sed -e "s|__CRU_TYPE__|$type|g" \
        -e "s|__CRU_TYPE_LABEL__|$type_label|g" \
        -e "s|__CRU_LANGUAGE__|$lang|g" \
        -e "s|__CRU_TF_MODULE__|$tf_module|g" \
        "$f" > "$f.use-stack.tmp"
    mv "$f.use-stack.tmp" "$f"
  done
}

substitute .github/workflows/pipeline-v2.yml package.json Dockerfile build.sh
chmod +x build.sh

# The template repository guards its own nightly run (it has no infrastructure).
# Your repo doesn't need that, so drop the guard.
awk '/>>> CRU-TEMPLATE-GUARD/{skip=1} !skip{print} /<<< CRU-TEMPLATE-GUARD/{skip=0}' \
  .github/workflows/pipeline-v2.yml > .github/workflows/pipeline-v2.yml.tmp
mv .github/workflows/pipeline-v2.yml.tmp .github/workflows/pipeline-v2.yml

# --- 3. Dependency updates for the activated language ------------------------

echo "→ Writing .github/dependabot.yml for $lang ($eco)…"
mkdir -p .github
cat > .github/dependabot.yml <<EOF
# Dependency updates for this app — generated by bin/use-stack ($type/$lang).
#
# Everything is GROUPED — one PR per ecosystem per week for minor+patch, so the
# dependabot-auto-merge workflow lands a single green PR instead of five. Major
# bumps are deliberately left ungrouped and unmerged, for a human to run the
# migration. The \`deps\` / \`ci\` / \`docker\` commit-message prefixes keep
# Dependabot's subjects Conventional-Commit valid, which the Validate PR Title
# check requires.
version: 2

updates:
  - package-ecosystem: "$eco"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 5
    groups:
      $eco-dependencies:
        patterns:
          - "*"
        update-types:
          - "minor"
          - "patch"
    commit-message:
      prefix: "deps"
      include: "scope"

  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 3
    groups:
      github-actions:
        patterns:
          - "*"
        update-types:
          - "minor"
          - "patch"
    commit-message:
      prefix: "ci"
      include: "scope"

  - package-ecosystem: "docker"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 2
    commit-message:
      prefix: "docker"
      include: "scope"
EOF

# --- 4. The app's PR check ---------------------------------------------------

# Replaces the template's self-check with a real CI for this language. The job
# is named `lint-and-build` — the fleet-standard required-check name. Mark it
# required in the repo's branch ruleset (configured via TerraBloks /
# cru-terraform) to gate merges and Dependabot auto-merge on it.
echo "→ Writing .github/workflows/ci.yml for ${lang}…"
mkdir -p .github/workflows

ci_header() {
  cat <<'YAML'
name: CI
# Runs on every pull request as the `lint-and-build` check. Mark it required in
# the repo's branch ruleset (configured via TerraBloks / cru-terraform) to gate
# merges — and Dependabot auto-merge — on it. Don't rename the job without
# updating the ruleset, or merges block on a check that never reports.
#
# Tests run only if you have any, so a fresh repo stays green. Drop the
# `--if-present` / `hashFiles` guard once you have a suite you want enforced.
on:
  pull_request:

jobs:
  lint-and-build:
    name: lint-and-build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
YAML
}

case "$lang" in
  nodejs)
    { ci_header; cat <<'YAML'
      - uses: actions/setup-node@v7
        with:
          node-version-file: .tool-versions
      - name: Install dependencies
        run: npm ci
      - name: Build
        run: npm run build
      - name: Type-check
        run: npm run typecheck --if-present
      - name: Test
        run: npm test --if-present
YAML
    } > .github/workflows/ci.yml
    ;;
  python)
    { ci_header; cat <<'YAML'
      - name: Read the Python version from .tool-versions
        id: pyver
        run: echo "version=$(awk '$1=="python"{print $2}' .tool-versions)" >> "$GITHUB_OUTPUT"
      - uses: actions/setup-python@v6
        with:
          python-version: ${{ steps.pyver.outputs.version }}
      - name: Install dependencies
        run: pip install -r requirements.txt
      - name: Syntax check
        run: python -m compileall -q .
      - name: Test
        if: ${{ hashFiles('tests/**', '**/test_*.py', '**/*_test.py') != '' }}
        run: |
          pip install pytest
          python -m pytest
YAML
    } > .github/workflows/ci.yml
    ;;
  ruby)
    { ci_header; cat <<'YAML'
      - uses: ruby/setup-ruby@v1
        with:
          bundler-cache: true
      - name: Syntax check
        run: |
          for f in $(git ls-files '*.rb' '*.ru'); do ruby -c "$f"; done
      - name: Test
        if: ${{ hashFiles('test/**', 'spec/**') != '' }}
        run: bundle exec rake test
YAML
    } > .github/workflows/ci.yml
    ;;
esac

# --- 5. Fill the docs in -----------------------------------------------------

# Each of README.md, AGENTS.md and QUICK_START.md has one
# <!-- CRU:STACK --> … <!-- /CRU:STACK --> block describing the not-yet-chosen
# stack. Replace each with the facts of the stack we just activated, so the docs
# stay true after activation instead of telling the reader to run this script
# again.
# The replacement text is passed as a FILE, not as `awk -v`: BSD awk (what
# macOS ships, and most of this fleet develops on a Mac) rejects a newline in a
# -v value, so a multi-line block has to be read with getline.
fill_block() {
  local file="$1" body_file="$2"
  [ -f "$file" ] || return 0
  awk -v bf="$body_file" '
    /<!-- CRU:STACK -->/ {
      print
      while ((getline line < bf) > 0) print line
      close(bf)
      skip = 1
      next
    }
    /<!-- \/CRU:STACK -->/ { skip = 0 }
    !skip { print }
  ' "$file" > "$file.use-stack.tmp"
  mv "$file.use-stack.tmp" "$file"
}

# Per-combo specifics for the doc blocks.
if [ "$family" = "server" ]; then
  case "$lang" in
    nodejs) install_cmd='npm ci'; run_cmd='npm run dev'; entry='src/index.ts' ;;
    python) install_cmd='pip install -r requirements.txt'; run_cmd='python app/main.py'; entry='app/main.py' ;;
    ruby)   install_cmd='bundle install'; run_cmd='bundle exec puma'; entry='config.ru' ;;
  esac
  shape_line="It listens on \`\$PORT\` (default \`8080\`) and answers **\`GET /health\`** (and \`/up\`) with \`{\"status\":\"ok\"}\`. Keep a health route working — $type_label judges every deploy by it."
else
  case "$lang" in
    nodejs) install_cmd='npm ci'; run_cmd='npm run build, then call the exported handler'; entry='src/index.ts' ;;
    python) install_cmd='pip install -r requirements.txt'; run_cmd='python -c "import handler; print(handler.handler({}, None))"'; entry='handler.py' ;;
    ruby)   install_cmd='bundle install'; run_cmd="ruby -r./handler -e 'p handler(event: {}, context: nil)'"; entry='handler.rb' ;;
  esac
  shape_line="It is a **handler invoked by an event** (API Gateway, SQS, an EventBridge schedule, …), not a web server — there is no \`\$PORT\` to bind and no health URL to curl. It returns \`{ statusCode: 200, body: '{\"status\":\"ok\"}' }\`. Keep the handler's signature and a fast, successful return — that's what Lambda invokes and deploys are judged by."
fi

blocks="$(mktemp -d)"
trap 'rm -rf "$blocks"' EXIT

cat > "$blocks/readme" <<EOF
This app runs on **$type_label** (\`type: $type\`) and is written in **$lang**.
Its entry point is \`$entry\`.

$shape_line

| Install | Run locally |
| ------- | ----------- |
| \`$install_cmd\` | \`$run_cmd\` |

\`./build.sh\` builds the container image exactly the way CI does.
EOF

cat > "$blocks/agents" <<EOF
**This repo's stack is already activated: $type / $lang.** It runs on
**$type_label** and is written in **$lang** — there is nothing to pick, and
\`bin/use-stack\` is gone. Build on \`$entry\`.

$shape_line

Run it locally with \`$install_cmd\` then \`$run_cmd\`. \`./build.sh\` builds the
container image exactly the way CI does.

The image is built by \`.github/workflows/pipeline-v2.yml\`, which passes
\`type: $type\` to CruGlobal/.github's \`build-candidate.yml\` — the one place the
runtime type appears in this repo. Everything after the build (deploy, promote,
rollback) resolves the type server-side from the app's CruApplicationInfo record.
EOF

cat > "$blocks/quickstart" <<EOF
This app's stack is **$type / $lang** — it runs on **$type_label** and is written
in **$lang**. It is provisioned with the
[$tf_module](https://github.com/CruGlobal/cru-terraform-modules/blob/main/$tf_module/README.md)
Terraform module.
EOF

echo "→ Filling in README.md, AGENTS.md and QUICK_START.md…"
fill_block README.md "$blocks/readme"
fill_block AGENTS.md "$blocks/agents"
fill_block QUICK_START.md "$blocks/quickstart"

# --- 6. Remove the scaffolding ----------------------------------------------

echo "→ Removing stacks/ and this script (one app now lives at the root)…"
rm -rf stacks
rm -f bin/use-stack
rmdir bin 2>/dev/null || true

cat <<EOF
✓ Done — the repo root now holds your $lang app for $type_label.

  Next:
   1. Review the files and commit ("chore: use the $type/$lang stack").
   2. Provision the app with TerraBloks — see QUICK_START.md. Nothing builds
      or deploys until that Terraform is applied.
   3. Read AGENTS.md before writing app code.
EOF
