#!/usr/bin/env bash
# Activate one stack for this Cru app.
#
#   bin/use-stack <ecs|cloudrun|lambda> <nodejs|ruby|python|go>
#
# Two axes, because a Cru app is two independent choices:
#
#   type      where it runs — ECS, Cloud Run, or Lambda. Under pipeline v2 this
#             only selects the BUILD recipe; deploy/promote/rollback resolve the
#             type server-side from the app's CruApplicationInfo record.
#   language  what it's written in.
#
# This copies the matching stack from stacks/ to the repo root, writes the
# type into .github/workflows/pipeline-v2.yml, writes a matching
# .github/dependabot.yml and .github/workflows/ci.yml, fills in the docs, then
# removes stacks/ and itself so the repo holds exactly one app. Run this ONCE
# near the start of a new app, then commit. See AGENTS.md.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

usage() {
  cat >&2 <<'EOF'
Usage: bin/use-stack <type> <language>

  type      ecs | cloudrun | lambda
  language  nodejs | ruby | python | go   (go: ecs and cloudrun only)

Examples:
  bin/use-stack ecs nodejs
  bin/use-stack lambda python
  bin/use-stack cloudrun ruby
  bin/use-stack ecs go
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

if [ "$#" -ne 2 ]; then
  echo "Error: expected exactly 2 arguments, got $#." >&2
  usage
  exit 1
fi

type="$1"
lang="$2"

# --- Validate the combo, and derive everything that depends on it -------------

# ecs and cloudrun both run "a server that listens on $PORT and answers a health
# check", and that scaffold is identical for them — the platform difference is
# entirely on the infrastructure side. So they share stacks/server/. Lambda is a
# genuinely different shape (a handler, no port) and has its own stacks/lambda/.
# See stacks/README.md.
case "$type" in
  ecs)
    family="server"; type_label="AWS ECS"; tf_module="aws/ecs/app" ;;
  cloudrun)
    family="server"; type_label="Google Cloud Run"; tf_module="gcp/cloudrun/app" ;;
  lambda)
    family="lambda"; type_label="AWS Lambda"; tf_module="aws/lambda/app" ;;
  *)
    echo "Error: unknown type '$type' (expected ecs, cloudrun, or lambda)." >&2
    usage
    exit 1
    ;;
esac

case "$lang" in
  nodejs) eco="npm" ;;
  ruby)   eco="bundler" ;;
  python) eco="pip" ;;
  go)     eco="gomod" ;;
  *)
    echo "Error: unknown language '$lang' (expected nodejs, ruby, python, or go)." >&2
    usage
    exit 1
    ;;
esac

# There is no Go stack for Lambda. A Go function runs on Lambda's OS-only
# runtime, which ignores AWS_LAMBDA_EXEC_WRAPPER, and that wrapper is how Cru's
# secrets-lambda-extension injects secrets. See stacks/README.md.
if [ "$family" = "lambda" ] && [ "$lang" = "go" ]; then
  echo "Error: there is no Go stack for lambda. Use ecs or cloudrun for a Go app," >&2
  echo "       or nodejs, ruby or python for a Lambda function." >&2
  exit 1
fi

# Go names its module after the repository, the way `go mod init` would in a
# fresh clone. The origin remote gives the real path. A copy with no remote, or
# a remote that isn't on GitHub, falls back to the directory's name.
go_module=""
if [ "$lang" = "go" ]; then
  remote="$(git remote get-url origin 2>/dev/null || true)"
  case "$remote" in
    *github.com[:/]*)
      # What follows the host is owner/repo, after a port when the remote names
      # one (ssh://git@github.com:22/..., or ssh.github.com:443 for SSH over
      # the HTTPS port).
      repo_path="${remote#*github.com}"
      repo_path="${repo_path#[:/]}"
      port="${repo_path%%/*}"
      case "$port" in
        "" | *[!0-9]*) ;;
        *) repo_path="${repo_path#*/}" ;;
      esac
      repo_path="${repo_path%/}"
      go_module="github.com/${repo_path%.git}"
      ;;
  esac
  # Anything but exactly owner/repo in safe characters (an SSH host alias, a
  # stray path) falls back to the directory name.
  case "$go_module" in
    github.com/*/*/* | *[!A-Za-z0-9._/-]*) go_module="" ;;
    github.com/?*/?*) ;;
    *) go_module="" ;;
  esac
  if [ -z "$go_module" ]; then
    go_module="github.com/CruGlobal/$(basename "$root" | tr -c 'A-Za-z0-9._\n-' '-')"
  fi
fi

stack="stacks/$family/$lang"

if [ ! -d stacks ]; then
  echo "Error: stacks/ is gone — this repo looks already activated." >&2
  echo "       bin/use-stack removes both itself and stacks/ after one run." >&2
  exit 1
fi

if [ ! -d "$stack" ]; then
  echo "Error: no stack at $stack (this shouldn't happen — is the repo complete?)." >&2
  exit 1
fi

if [ -e Dockerfile ]; then
  echo "Error: there is already a Dockerfile at the repo root." >&2
  echo "       Refusing to overwrite your app. Remove it first if you meant to" >&2
  echo "       start over from a stack." >&2
  exit 1
fi

echo "→ Activating the $type / $lang stack ($type_label, from $stack)…"

# --- 1. Copy the stack to the root -------------------------------------------

# Copy everything in the stack — including dotfiles like .tool-versions.
cp -R "$stack/." .

# --- 2. Substitute placeholders ----------------------------------------------

# Portable in-place sed (BSD sed's -i needs an argument; GNU's doesn't). Note
# that rewrite-and-mv resets the file mode to the umask default, so anything
# that must stay executable is chmod'd AFTER this runs, not before.
substitute() {
  local f
  for f in "$@"; do
    [ -f "$f" ] || continue
    sed -e "s|__CRU_TYPE__|$type|g" \
        -e "s|__CRU_TYPE_LABEL__|$type_label|g" \
        -e "s|__CRU_LANGUAGE__|$lang|g" \
        -e "s|__CRU_TF_MODULE__|$tf_module|g" \
        -e "s|__CRU_GO_MODULE__|$go_module|g" \
        "$f" > "$f.use-stack.tmp"
    mv "$f.use-stack.tmp" "$f"
  done
}

substitute .github/workflows/pipeline-v2.yml package.json Dockerfile build.sh go.mod
chmod +x build.sh

# `go build ./cmd/server` leaves a binary named server at the root. Ignore it
# in Go apps only: in another language, server/ may well be source.
if [ "$lang" = "go" ]; then
  printf '\n# The binary `go build ./cmd/server` writes\n/server\n' >> .gitignore
fi

# The template repository guards its own nightly run (it has no infrastructure).
# Your repo doesn't need that, so drop the guard.
awk '/>>> CRU-TEMPLATE-GUARD/{skip=1} !skip{print} /<<< CRU-TEMPLATE-GUARD/{skip=0}' \
  .github/workflows/pipeline-v2.yml > .github/workflows/pipeline-v2.yml.tmp
mv .github/workflows/pipeline-v2.yml.tmp .github/workflows/pipeline-v2.yml

# --- 3. Dependency updates for the activated language ------------------------

echo "→ Writing .github/dependabot.yml for $lang ($eco)…"
mkdir -p .github
cat > .github/dependabot.yml <<EOF
# Dependency updates for this app — generated by bin/use-stack ($type/$lang).
#
# Everything is GROUPED — one PR per ecosystem per week for minor+patch, so the
# dependabot-auto-merge workflow lands a single green PR instead of five. Major
# bumps are deliberately left ungrouped and unmerged, for a human to run the
# migration. The \`deps\` / \`ci\` / \`docker\` commit-message prefixes keep
# Dependabot's subjects Conventional-Commit valid, which the Validate PR Title
# check requires.
version: 2

updates:
  - package-ecosystem: "$eco"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 5
    groups:
      $eco-dependencies:
        patterns:
          - "*"
        update-types:
          - "minor"
          - "patch"
    commit-message:
      prefix: "deps"
      include: "scope"

  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 3
    groups:
      github-actions:
        patterns:
          - "*"
        update-types:
          - "minor"
          - "patch"
    commit-message:
      prefix: "ci"
      include: "scope"

  - package-ecosystem: "docker"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 2
    commit-message:
      prefix: "docker"
      include: "scope"
EOF

# --- 4. The app's PR check ---------------------------------------------------

# Replaces the template's self-check with a real CI for this language. The job
# is named `lint-and-build` — the fleet-standard required-check name. Mark it
# required in the repo's branch ruleset (configured via TerraBloks /
# cru-terraform) to gate merges and Dependabot auto-merge on it.
echo "→ Writing .github/workflows/ci.yml for ${lang}…"
mkdir -p .github/workflows

ci_header() {
  cat <<'YAML'
name: CI
# Runs on every pull request as the `lint-and-build` check. Mark it required in
# the repo's branch ruleset (configured via TerraBloks / cru-terraform) to gate
# merges — and Dependabot auto-merge — on it. Don't rename the job without
# updating the ruleset, or merges block on a check that never reports.
#
# Tests run only if you have any, so a fresh repo stays green. Drop the
# `--if-present` / `hashFiles` guard once you have a suite you want enforced.
on:
  pull_request:

jobs:
  lint-and-build:
    name: lint-and-build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
YAML
}

case "$lang" in
  nodejs)
    { ci_header; cat <<'YAML'
      - uses: actions/setup-node@v7
        with:
          node-version-file: .tool-versions
      - name: Install dependencies
        run: npm ci
      - name: Build
        run: npm run build
      - name: Type-check
        run: npm run typecheck --if-present
      - name: Test
        run: npm test --if-present
YAML
    } > .github/workflows/ci.yml
    ;;
  python)
    { ci_header; cat <<'YAML'
      - name: Read the Python version from .tool-versions
        id: pyver
        run: echo "version=$(awk '$1=="python"{print $2}' .tool-versions)" >> "$GITHUB_OUTPUT"
      - uses: actions/setup-python@v6
        with:
          python-version: ${{ steps.pyver.outputs.version }}
      - name: Install dependencies
        run: pip install -r requirements.txt
      - name: Syntax check
        run: python -m compileall -q .
      - name: Test
        if: ${{ hashFiles('tests/**', '**/test_*.py', '**/*_test.py') != '' }}
        run: |
          pip install pytest
          python -m pytest
YAML
    } > .github/workflows/ci.yml
    ;;
  ruby)
    { ci_header; cat <<'YAML'
      - uses: ruby/setup-ruby@v1
        with:
          bundler-cache: true
      - name: Syntax check
        run: |
          for f in $(git ls-files '*.rb' '*.ru'); do ruby -c "$f"; done
      - name: Test
        if: ${{ hashFiles('test/**', 'spec/**') != '' }}
        run: bundle exec rake test
YAML
    } > .github/workflows/ci.yml
    ;;
  go)
    # Go tests always run: a Go stack ships with tests, and `go test` passes
    # when a package has none.
    { ci_header; cat <<'YAML'
      - uses: actions/setup-go@v7
        with:
          go-version-file: .tool-versions
      - name: Read the golangci-lint version from .tool-versions
        id: lintver
        run: echo "version=v$(awk '$1=="golangci-lint"{print $2}' .tool-versions)" >> "$GITHUB_OUTPUT"
      - name: Lint
        uses: golangci/golangci-lint-action@v9
        with:
          version: ${{ steps.lintver.outputs.version }}
      - name: Build
        run: go build ./...
      - name: Test
        run: go test -race ./...
YAML
    } > .github/workflows/ci.yml
    ;;
esac

# --- 5. Fill the docs in -----------------------------------------------------

# Each of README.md, AGENTS.md and QUICK_START.md has one
# <!-- CRU:STACK --> … <!-- /CRU:STACK --> block describing the not-yet-chosen
# stack, and a <!-- CRU:DATABASE --> … <!-- /CRU:DATABASE --> block for the
# database helper. Replace each with the facts of the stack we just activated, so
# the docs stay true after activation instead of telling the reader to run this
# script again.
# The replacement text is passed as a FILE, not as `awk -v`: BSD awk (what
# macOS ships, and most of this fleet develops on a Mac) rejects a newline in a
# -v value, so a multi-line block has to be read with getline.
fill_block() {
  local file="$1" name="$2" body_file="$3"
  [ -f "$file" ] || return 0
  awk -v bf="$body_file" -v open="<!-- CRU:$name -->" -v close_tag="<!-- /CRU:$name -->" '
    $0 == open {
      print
      while ((getline line < bf) > 0) print line
      close(bf)
      skip = 1
      next
    }
    $0 == close_tag { skip = 0 }
    !skip { print }
  ' "$file" > "$file.use-stack.tmp"
  mv "$file.use-stack.tmp" "$file"
}

# Per-combo specifics for the doc blocks.
db_migrate='A migrations job uses the same variables and the same helper. If you turn on
`database_migrations` in the Terraform, call the helper from the migration
script and no other wiring is needed.'
if [ "$family" = "server" ]; then
  case "$lang" in
    nodejs)
      install_cmd='npm ci'; run_cmd='npm run dev'; entry='src/index.ts'; gate_file='src/app.ts'
      db_file='src/db.ts'; db_call='getPool()'
      db_vars='`DATABASE_HOST`, `DATABASE_NAME` and `DATABASE_USER`'
      db_extra='- In a one-off script such as a migration, call `await closeDb()` in a `finally`
  block, or the pool keeps the process alive and the job never exits.' ;;
    python)
      install_cmd='pip install -r requirements.txt'; run_cmd='python -m app.main'; entry='app/main.py'; gate_file='app/main.py'
      db_file='app/db.py'; db_call='connect()'
      db_vars='`DATABASE_HOST`, `DATABASE_NAME`, `DATABASE_USER` and `INSTANCE_CONNECTION_NAME`'
      db_extra='' ;;
    ruby)
      install_cmd='bundle install'; run_cmd='bundle exec puma'; entry='config.ru'; gate_file='lib/app.rb'
      db_file='lib/db.rb'; db_call='Db.connect'
      db_vars='`DATABASE_HOST`, `DATABASE_NAME` and `DATABASE_USER`'
      db_extra='' ;;
    go)
      install_cmd='go mod download'; run_cmd='go run ./cmd/server'; entry='cmd/server/main.go'; gate_file='cmd/server/iap.go'
      db_file='internal/db/db.go'; db_call='db.Open(ctx)'
      db_vars='`DATABASE_HOST`, `DATABASE_NAME` and `DATABASE_USER`'
      db_extra='- The pool connects lazily, so a wrong setting shows up on the first query,
  not at startup. Call `pool.Ping(ctx)` after `db.Open` to fail fast instead.'
      db_migrate='A migrations job uses the same variables and the same helper. The image holds
only the `/server` binary, so give it a `migrate` subcommand (or build a second
binary into the image) and point `database_migrations.command` at it. README.md
shows both.' ;;
  esac
  shape_line="It listens on \`\$PORT\` (default \`8080\`) and answers **\`GET /health\`** (and \`/up\`) with \`{\"status\":\"ok\"}\`. Keep a health route working — $type_label judges every deploy by it."
else
  case "$lang" in
    nodejs) install_cmd='npm ci'; run_cmd='npm run build, then call the exported handler'; entry='src/index.ts' ;;
    python) install_cmd='pip install -r requirements.txt'; run_cmd='python -c "import handler; print(handler.handler({}, None))"'; entry='handler.py' ;;
    ruby)   install_cmd='bundle install'; run_cmd="ruby -r./handler -e 'p handler(event: {}, context: nil)'"; entry='handler.rb' ;;
  esac
  shape_line="It is a **handler invoked by an event** (API Gateway, SQS, an EventBridge schedule, …), not a web server — there is no \`\$PORT\` to bind and no health URL to curl. It returns \`{ statusCode: 200, body: '{\"status\":\"ok\"}' }\`. Keep the handler's signature and a fast, successful return — that's what Lambda invokes and deploys are judged by."
fi

blocks="$(mktemp -d)"
trap 'rm -rf "$blocks"' EXIT

cat > "$blocks/readme" <<EOF
This app runs on **$type_label** (\`type: $type\`) and is written in **$lang**.
Its entry point is \`$entry\`.

$shape_line

| Install | Run locally |
| ------- | ----------- |
| \`$install_cmd\` | \`$run_cmd\` |

\`./build.sh\` builds the container image exactly the way CI does.
EOF

cat > "$blocks/agents" <<EOF
**This repo's stack is already activated: $type / $lang.** It runs on
**$type_label** and is written in **$lang** — there is nothing to pick, and
\`bin/use-stack\` is gone. Build on \`$entry\`.

$shape_line

Run it locally with \`$install_cmd\` then \`$run_cmd\`. \`./build.sh\` builds the
container image exactly the way CI does.

The image is built by \`.github/workflows/pipeline-v2.yml\`, which passes
\`type: $type\` to CruGlobal/.github's \`build-candidate.yml\` — the one place the
runtime type appears in this repo. Everything after the build (deploy, promote,
rollback) resolves the type server-side from the app's CruApplicationInfo record.
EOF

if [ "$lang" = "go" ]; then
  cat >> "$blocks/agents" <<'EOF'

Before you push, run `golangci-lint run` and `go test -race ./...`. CI runs both,
at the versions pinned in `.tool-versions`. Keep new packages under `internal/`
and new programs under `cmd/<name>/`.
EOF
fi

cat > "$blocks/quickstart" <<EOF
This app's stack is **$type / $lang** — it runs on **$type_label** and is written
in **$lang**. It is provisioned with the
[$tf_module](https://github.com/CruGlobal/cru-terraform-modules/blob/main/$tf_module/README.md)
Terraform module.
EOF

# The database helper ships in the server stacks only (ecs and cloudrun). The
# README part is a fragment per language under stacks/docs/, because it carries
# a code example and a dependency list.
if [ "$family" = "server" ]; then
  cp "stacks/docs/database-$lang.md" "$blocks/db_readme"

  cat > "$blocks/db_agents" <<EOF
The stack ships a database helper, \`$db_file\`. Use it instead of writing your own
connection code, and never ask for or store a database password. It does nothing
until you call \`$db_call\`, so an app with no database is unaffected.

- **IAM mode** (the default on Cloud Run): $db_vars are set.
  The service account logs in with IAM, so there is no password.
- **Password mode** (works anywhere, including ECS): \`DATABASE_URL\` or
  \`DATABASE_PASSWORD\` is set. It wins over IAM mode. Use it for a local Postgres.
EOF
  if [ -n "$db_extra" ]; then
    echo "$db_extra" >> "$blocks/db_agents"
  fi
  cat >> "$blocks/db_agents" <<'EOF'

The "Database (Cloud SQL)" section of README.md has the details and an example.
EOF

  cat > "$blocks/db_quickstart" <<EOF
If the app has a Cloud SQL database (from step 2), the stack already has a small
helper that connects to it: \`$db_file\`. Nothing connects at startup, so an app
with no database is unaffected. Call the helper from your code when you need a
connection. Code examples are in
[README.md](./README.md#database-cloud-sql).

IAM login is the default on Cloud Run. The service account is the database user
and no password is stored. The platform sets the connection variables, and the
helper picks its mode from them. IAM mode is used when these are set:
$db_vars. Password mode is used when \`DATABASE_URL\` or \`DATABASE_PASSWORD\` is
set. Password mode works anywhere, including ECS, and is how you use a local
Postgres.

$db_migrate
EOF
else
  cat > "$blocks/db_readme" <<EOF
The lambda stacks have no database helper. If the function needs a database,
that is a TerraBloks change (see [QUICK_START.md](./QUICK_START.md)). Read the
connection settings from environment variables, and never commit a password.
EOF
  cp "$blocks/db_readme" "$blocks/db_agents"
  cp "$blocks/db_readme" "$blocks/db_quickstart"
fi

# How to report errors to Flightdeck with this stack's Rollbar SDK. One fragment
# per family and language, because a server and a Lambda function flush
# differently.
cp "stacks/docs/errors-$family-$lang.md" "$blocks/errors"

# The IAP gate ships in server stacks only; ECS has no IAP in front, so its docs
# say to remove the gate. Lambda has no gate, so its blocks are emptied.
: > "$blocks/iap_readme"; : > "$blocks/iap_agents"; : > "$blocks/iap_quickstart"
if [ "$family" = "server" ]; then
  if [ "$type" = "cloudrun" ]; then
    iap_lead='TerraBloks puts **Google Identity-Aware Proxy** in front of new Cloud Run
apps by default: people sign in with Okta at the load balancer, before a request
reaches the app, and the platform sets `IAP_AUDIENCE`.'
  else
    iap_lead='**This is an ECS app, and ECS has no IAP in front of it.** The starter still
ships the sign-in gate, so once deployed every route but `/up` answers 401.
Remove the gate, or replace it with the sign-in the app needs, before you rely
on a deploy.'
  fi

  cat > "$blocks/iap_readme" <<EOF
## Sign-in (Google IAP)

$iap_lead

The gate is in \`$gate_file\` and uses
[\`cru-iap\`](https://github.com/CruGlobal/cru-iap):

- Every route except the \`/up\` health check needs IAP's signed assertion.
  Anything else gets a 401 and an \`iap_rejected\` log line with the reason.
  \`/\` greets the signed-in email.
- **Running locally:** \`.env.development\` sets
  \`CRU_IAP_DEV_BYPASS_EMAIL=replace-me@cru.org\`. Replace it with your own
  email, and \`$run_cmd\` signs every request in as you. cru-iap ignores it
  when \`IAP_AUDIENCE\` is set or on Cloud Run, and \`.dockerignore\` keeps the
  file out of the image.
- **Sign out** by linking to \`/?gcp-iap-mode=CLEAR_LOGIN_COOKIE\`.
EOF
  if [ "$type" = "cloudrun" ]; then
    cat >> "$blocks/iap_readme" <<'EOF'
- **A path that must skip sign-in** (a webhook, a cron call) needs an
  `iap.bypass_paths` entry in the Terraform (the default is `["/up"]`), an
  exemption in the gate, and its own credential check.
- **Opting out of IAP** (another Okta option in TerraBloks) means no
  `IAP_AUDIENCE`, so the gate 401s everything. Remove or replace it.
EOF
  fi

  cat > "$blocks/iap_agents" <<EOF
## Sign-in (Google IAP)

$iap_lead

The gate is in \`$gate_file\` and uses
[\`cru-iap\`](https://github.com/CruGlobal/cru-iap). Every route but \`/up\`
needs IAP's signed assertion, or else a 401. The README's
[Sign-in section](./README.md#sign-in-google-iap) has the details. Rules:

- **Never weaken the gate.** No boolean "auth off" flag, no fallback identity,
  and no opening a path because the header is missing or \`IAP_AUDIENCE\` is
  unset. For a local identity, \`CRU_IAP_DEV_BYPASS_EMAIL\` in
  \`.env.development\`; never set it in deploy config.
- **Identity is only the email.** The assertion carries no groups. "Who may get
  in" is the Okta group bound in Terraform, not app code.
- **Sign out** with \`/?gcp-iap-mode=CLEAR_LOGIN_COOKIE\`.
EOF
  if [ "$type" = "cloudrun" ]; then
    cat >> "$blocks/iap_agents" <<'EOF'
- **A path that skips sign-in needs both halves**: an `iap.bypass_paths` entry
  in the Terraform (a TerraBloks / `cru-terraform` change) and an exemption in
  the gate, plus its own credential check. Never read identity on it.
EOF
  fi

  cat > "$blocks/iap_quickstart" <<EOF
**Before you first run it locally,** open \`.env.development\` and replace
\`replace-me@cru.org\` with your own email. Every route but \`/up\` needs a
signed-in person, and locally that is you. The file stays out of the image.
See [Sign-in (Google IAP)](./README.md#sign-in-google-iap).

$iap_lead
EOF
fi

echo "→ Filling in README.md, AGENTS.md and QUICK_START.md…"
fill_block README.md STACK "$blocks/readme"
fill_block AGENTS.md STACK "$blocks/agents"
fill_block QUICK_START.md STACK "$blocks/quickstart"
fill_block README.md DATABASE "$blocks/db_readme"
fill_block AGENTS.md DATABASE "$blocks/db_agents"
fill_block QUICK_START.md DATABASE "$blocks/db_quickstart"
fill_block AGENTS.md ERRORS "$blocks/errors"
fill_block README.md IAP "$blocks/iap_readme"
fill_block AGENTS.md IAP "$blocks/iap_agents"
fill_block QUICK_START.md IAP "$blocks/iap_quickstart"

# --- 6. Remove the scaffolding ----------------------------------------------

echo "→ Removing stacks/ and this script (one app now lives at the root)…"
rm -rf stacks
rm -f bin/use-stack
